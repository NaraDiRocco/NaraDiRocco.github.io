---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '@lib/utils';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
---

<article class="group bg-white border border-gray-mid rounded-sm overflow-hidden hover:shadow-lg transition-all duration-300">
  <!-- Imagen / Placeholder -->
  <div class="aspect-video bg-gradient-to-br from-navy to-navy-mid relative overflow-hidden">
    {post.data.coverImage ? (
      <img
        src={post.data.coverImage}
        alt=""
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
    ) : (
      <div class="absolute inset-0 flex items-center justify-center">
        <span class="font-heading font-bold text-white/20 text-5xl uppercase tracking-widest">
          {post.data.category?.[0] ?? 'N'}
        </span>
      </div>
    )}
  </div>

  <div class="p-6">
    <!-- Meta -->
    <div class="flex items-center gap-3 mb-3 flex-wrap">
      <span class="bg-gold text-navy text-[10px] font-heading font-bold uppercase tracking-wider px-2 py-0.5 rounded-sm">
        {post.data.category}
      </span>
      <time
        class="text-gray-text text-xs"
        datetime={post.data.publishDate.toISOString()}
      >
        {formatDate(post.data.publishDate)}
      </time>
    </div>

    <!-- Título -->
    <h3 class="font-heading font-bold text-navy text-base leading-tight mb-2 group-hover:text-navy-mid transition-colors">
      <a href={`/novedades/${post.id}`} class="hover:underline">
        {post.data.title}
      </a>
    </h3>

    <!-- Descripción -->
    <p class="text-gray-text text-sm leading-relaxed mb-4 line-clamp-3">
      {post.data.description}
    </p>

    <!-- Footer -->
    <div class="flex items-center justify-between">
      <span class="text-gray-text text-xs">{post.data.author}</span>
      <a
        href={`/novedades/${post.id}`}
        class="inline-flex items-center gap-1.5 text-navy-mid hover:text-gold text-xs font-heading font-semibold uppercase tracking-wider transition-colors"
        aria-label={`Leer ${post.data.title}`}
      >
        Leer →
      </a>
    </div>
  </div>
</article>
