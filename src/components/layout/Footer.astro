---
import { Image } from 'astro:assets';
import logo from '@assets/images/logo.png';

const currentYear = new Date().getFullYear();
const currentPath = Astro.url.pathname;
const currentLang = currentPath.startsWith('/en') ? 'en' : currentPath.startsWith('/pt') ? 'pt' : 'es';

const navLinks = currentLang === 'en'
  ? [
      { href: '/en/about', label: 'About Us' },
      { href: '/en/about#team', label: 'Our Team' },
      { href: '/en/services', label: 'Practice Areas' },
      { href: '/en/news', label: 'News' },
      { href: '/en/contact', label: 'Contact' },
    ]
  : currentLang === 'pt'
  ? [
      { href: '/pt/sobre', label: 'Sobre nós' },
      { href: '/pt/sobre#team', label: 'Nossa equipe' },
      { href: '/pt/servicos', label: 'Áreas de prática' },
      { href: '/pt/noticias', label: 'Notícias' },
      { href: '/pt/contato', label: 'Contato' },
    ]
  : [
      { href: '/nosotros', label: 'Nosotros' },
      { href: '/nosotros#equipo', label: 'Nuestro Equipo' },
      { href: '/servicios', label: 'Áreas de práctica' },
      { href: '/novedades', label: 'Novedades' },
      { href: '/contacto', label: 'Contacto' },
    ];

const serviceLinks = currentLang === 'en'
  ? [
      { href: '/en/services/01-notarial-real-estate', label: 'Notarial / Real Estate' },
      { href: '/en/services/02-residencias', label: 'Residency' },
      { href: '/en/services/03-servicios-contables', label: 'Accounting Services' },
      { href: '/en/services/04-compliance', label: 'Compliance' },
      { href: '/en/services', label: 'View all practice areas' },
    ]
  : currentLang === 'pt'
  ? [
      { href: '/pt/servicos/01-notarial-real-estate', label: 'Notarial / Real Estate' },
      { href: '/pt/servicos/02-residencias', label: 'Residências' },
      { href: '/pt/servicos/03-servicios-contables', label: 'Serviços Contábeis' },
      { href: '/pt/servicos/04-compliance', label: 'Compliance' },
      { href: '/pt/servicos', label: 'Ver todas as áreas' },
    ]
  : [
      { href: '/servicios/01-notarial-real-estate', label: 'Notarial / Real Estate' },
      { href: '/servicios/02-residencias', label: 'Residencias' },
      { href: '/servicios/03-servicios-contables', label: 'Servicios Contables' },
      { href: '/servicios/04-compliance', label: 'Compliance' },
      { href: '/servicios', label: 'Ver todas las áreas' },
    ];
---

<footer class="bg-navy text-white">
  <div class="container-main section-padding-sm">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8">
      <div class="lg:col-span-1">
        <a href={currentLang === 'es' ? '/' : currentLang === 'en' ? '/en' : '/pt'} aria-label="MECOL ESTUDIO - Inicio" class="inline-block mb-4">
          <Image src={logo} alt="MECOL ESTUDIO" width={152} height={48} densities={[1.5, 2]} format="png" class="w-auto object-contain" loading="lazy" />
        </a>
        <p class="text-white/60 text-sm leading-relaxed mt-4 max-w-xs">
          {currentLang === 'en'
            ? 'Legal, notarial and accounting solutions for operations, filings and investments focused on Punta del Este.'
            : currentLang === 'pt'
            ? 'Soluções jurídicas, notariais e contábeis para operações, trâmites e investimentos com foco em Punta del Este.'
            : 'Soluciones legales, notariales y contables para operaciones, trámites e inversiones con foco en Punta del Este.'}
        </p>
      </div>

      <div>
        <h3 class="font-heading font-semibold text-xs uppercase tracking-widest text-gold mb-4">{currentLang === 'en' ? 'Navigation' : currentLang === 'pt' ? 'Navegação' : 'Navegación'}</h3>
        <ul class="flex flex-col gap-2">
          {navLinks.map(({ href, label }) => (
            <li><a href={href} class="text-white/60 hover:text-white text-sm transition-colors duration-200">{label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="font-heading font-semibold text-xs uppercase tracking-widest text-gold mb-4">{currentLang === 'en' ? 'Practice Areas' : 'Áreas de prática'}</h3>
        <ul class="flex flex-col gap-2">
          {serviceLinks.map(({ href, label }) => (
            <li><a href={href} class="text-white/60 hover:text-white text-sm transition-colors duration-200">{label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="font-heading font-semibold text-xs uppercase tracking-widest text-gold mb-4">{currentLang === 'en' ? 'Contact' : currentLang === 'pt' ? 'Contato' : 'Contacto'}</h3>
        <address class="not-italic flex flex-col gap-3 text-sm text-white/60">
          <span>Calle 10 y 11, oficina N.º 101 Edificio Gala Puerto. Punta del Este</span>
          <a href="tel:+59899759109" class="hover:text-white transition-colors">+598 99 759 109</a>
          <a href="mailto:info@mecolestudio.com" class="hover:text-white transition-colors break-all">info@mecolestudio.com</a>
          <span>{currentLang === 'en' ? 'Office hours: 10:00 AM to 6:00 PM' : currentLang === 'pt' ? 'Horário de atendimento: 10h às 18h' : 'Horario de atención: 10 a 18 hs'}</span>
        </address>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-main py-5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-white/40">
      <p>© {currentYear} MECOL ESTUDIO. {currentLang === 'en' ? 'All rights reserved.' : currentLang === 'pt' ? 'Todos os direitos reservados.' : 'Todos los derechos reservados.'}</p>
      <p class="hidden">
        {currentLang === 'en' ? 'Web design and development by' : currentLang === 'pt' ? 'Design e desenvolvimento web por' : 'Diseño y desarrollo web por'}
        <a href={currentLang === 'es' ? '/' : currentLang === 'en' ? '/en' : '/pt'} class="text-white/60 hover:text-white transition-colors">MECOL ESTUDIO</a>
      </p>
    </div>
  </div>
</footer>
