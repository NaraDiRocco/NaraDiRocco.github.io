---
import { Image } from 'astro:assets';
import logo from '@assets/images/logo.png';

type Lang = 'es' | 'en' | 'pt';
const currentPath = Astro.url.pathname;
const normalizedPath = currentPath.replace(/\/$/, '') || '/';

function getLang(path: string): Lang {
  if (path.startsWith('/en')) return 'en';
  if (path.startsWith('/pt')) return 'pt';
  return 'es';
}

const currentLang = getLang(normalizedPath);
const isHomePage = normalizedPath === '/' || normalizedPath === '/en' || normalizedPath === '/pt';

const navByLang: Record<Lang, { href: string; label: string }[]> = {
  es: [
    { href: '/nosotros', label: 'Nosotros' },
    { href: '/servicios', label: 'Áreas de práctica' },
    { href: '/novedades', label: 'Novedades' },
    { href: '/contacto', label: 'Contacto' },
  ],
  en: [
    { href: '/en/about', label: 'About Us' },
    { href: '/en/services', label: 'Practice Areas' },
    { href: '/en/news', label: 'News' },
    { href: '/en/contact', label: 'Contact' },
  ],
  pt: [
    { href: '/pt/sobre', label: 'Sobre nós' },
    { href: '/pt/servicos', label: 'Áreas de prática' },
    { href: '/pt/noticias', label: 'Notícias' },
    { href: '/pt/contato', label: 'Contato' },
  ],
};

const navLinks = navByLang[currentLang];

function isActive(href: string): boolean {
  if (href === '/' || href === '/en' || href === '/pt') return currentPath === href;
  return currentPath.startsWith(href);
}

function toLangPath(path: string, target: Lang): string {
  const map: Record<string, { es: string; en: string; pt: string }> = {
    '/': { es: '/', en: '/en', pt: '/pt' },
    '/nosotros': { es: '/nosotros', en: '/en/about', pt: '/pt/sobre' },
    '/servicios': { es: '/servicios', en: '/en/services', pt: '/pt/servicos' },
    '/novedades': { es: '/novedades', en: '/en/news', pt: '/pt/noticias' },
    '/contacto': { es: '/contacto', en: '/en/contact', pt: '/pt/contato' },
    '/novedades/que-es-una-sas': { es: '/novedades/que-es-una-sas', en: '/en/news/what-is-a-sas', pt: '/pt/noticias/o-que-e-uma-sas' },
  };

  if (map[path]) return map[path][target];
  if (path.startsWith('/servicios/')) {
    const slug = path.replace('/servicios/', '');
    if (target === 'es') return `/servicios/${slug}`;
    if (target === 'en') return `/en/services/${slug}`;
    return `/pt/servicos/${slug}`;
  }
  if (path.startsWith('/en/services/')) {
    const slug = path.replace('/en/services/', '');
    if (target === 'es') return `/servicios/${slug}`;
    if (target === 'en') return `/en/services/${slug}`;
    return `/pt/servicos/${slug}`;
  }
  if (path.startsWith('/pt/servicos/')) {
    const slug = path.replace('/pt/servicos/', '');
    if (target === 'es') return `/servicios/${slug}`;
    if (target === 'en') return `/en/services/${slug}`;
    return `/pt/servicos/${slug}`;
  }
  return target === 'es' ? '/' : target === 'en' ? '/en' : '/pt';
}

const langLinks = {
  es: toLangPath(normalizedPath, 'es'),
  en: toLangPath(normalizedPath, 'en'),
  pt: toLangPath(normalizedPath, 'pt'),
};
---

<header
  id="site-header"
  class:list={[
    'fixed top-0 left-0 right-0 z-[1200] transition-all duration-300 pt-[var(--header-top-padding)] bg-transparent backdrop-blur-0',
  ]}
  style="--header-height: 4.5rem; --header-top-padding: 0.75rem;"
>
  <div class="container-main">
    <div class="flex items-center justify-between h-[var(--header-height)]">
      <a href={currentLang === 'es' ? '/' : currentLang === 'en' ? '/en' : '/pt'} class="flex items-center group" aria-label="MECOL ESTUDIO - Inicio">
        <Image src={logo} alt="MECOL ESTUDIO" width={126} height={40} densities={[1.5, 2]} format="png" class="w-auto object-contain" loading="eager" />
      </a>

      <nav class="hidden lg:flex items-center gap-1" aria-label={currentLang === 'es' ? 'Navegación principal' : currentLang === 'en' ? 'Main navigation' : 'Navegação principal'}>
        {navLinks.map(({ href, label }) => (
          <a
            href={href}
            class={`relative px-4 py-2 text-xs font-heading font-semibold uppercase tracking-widest transition-colors duration-200 ${isActive(href) ? 'text-gold' : 'text-white/80 hover:text-white'}`}
            aria-current={isActive(href) ? 'page' : undefined}
          >
            {label}
            {isActive(href) && <span class="absolute bottom-0 left-4 right-4 h-0.5 bg-gold rounded-full" aria-hidden="true" />}
          </a>
        ))}

        <a
          href={currentLang === 'es' ? '/contacto' : currentLang === 'en' ? '/en/contact' : '/pt/contato'}
          class="ml-4 px-5 py-2 bg-gold text-navy text-xs font-heading font-bold uppercase tracking-widest rounded-sm hover:bg-gold-light transition-colors duration-200"
        >
          {currentLang === 'es' ? 'Consulta Gratis' : currentLang === 'en' ? 'Free Consultation' : 'Consulta gratuita'}
        </a>

        <div class="flex items-center gap-2 ml-4 pl-4 border-l border-white/20" aria-label="Cambiar idioma">
          <a href={langLinks.es} class={`text-xs font-heading font-semibold uppercase tracking-widest transition-colors ${currentLang === 'es' ? 'text-gold' : 'text-white/50 hover:text-white'}`}>ES</a>
          <span class="text-white/30 text-xs" aria-hidden="true">|</span>
          <a href={langLinks.en} class={`text-xs font-heading font-semibold uppercase tracking-widest transition-colors ${currentLang === 'en' ? 'text-gold' : 'text-white/50 hover:text-white'}`}>EN</a>
          <span class="text-white/30 text-xs" aria-hidden="true">|</span>
          <a href={langLinks.pt} class={`text-xs font-heading font-semibold uppercase tracking-widest transition-colors ${currentLang === 'pt' ? 'text-gold' : 'text-white/50 hover:text-white'}`}>PT</a>
        </div>
      </nav>

      <button id="mobile-menu-toggle" class="lg:hidden relative z-[1300] flex flex-col justify-center items-center w-10 h-10 gap-1.5 rounded focus-visible:outline-2 focus-visible:outline-gold" aria-expanded="false" aria-controls="mobile-menu" aria-label="Abrir menú" type="button">
        <span class="hamburger-line w-6 h-0.5 bg-white rounded-full transition-all duration-300 origin-center"></span>
        <span class="hamburger-line w-6 h-0.5 bg-white rounded-full transition-all duration-300"></span>
        <span class="hamburger-line w-6 h-0.5 bg-white rounded-full transition-all duration-300 origin-center"></span>
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" class="lg:hidden hidden fixed inset-0 z-[1250] bg-navy flex flex-col" role="dialog" aria-label="Menú de navegación" aria-modal="true">
  <div class="flex items-center justify-between px-6 shrink-0 border-b border-white/10" style="height: calc(4.5rem + 0.75rem);">
    <a href={currentLang === 'es' ? '/' : currentLang === 'en' ? '/en' : '/pt'} aria-label="MECOL ESTUDIO - Inicio">
      <Image src={logo} alt="MECOL ESTUDIO" width={126} height={40} densities={[1.5, 2]} format="png" class="w-auto object-contain" loading="eager" />
    </a>
    <button id="mobile-menu-close" class="flex items-center justify-center w-10 h-10 rounded focus-visible:outline-2 focus-visible:outline-gold" aria-label="Cerrar menú" type="button">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
    </button>
  </div>

  <nav class="flex flex-col items-center justify-center flex-1 gap-1 px-8">
    {navLinks.map(({ href, label }) => (
      <a href={href} class={`w-full text-center px-6 py-5 text-2xl font-heading font-semibold uppercase tracking-widest rounded-sm transition-colors duration-200 ${isActive(href) ? 'text-gold bg-white/5' : 'text-white/80 hover:text-white hover:bg-white/5'}`} aria-current={isActive(href) ? 'page' : undefined}>
        {label}
      </a>
    ))}
    <div class="mt-10 pt-6 border-t border-white/10 w-full flex flex-col gap-4 items-center">
      <a href={currentLang === 'es' ? '/contacto' : currentLang === 'en' ? '/en/contact' : '/pt/contato'} class="block w-full text-center px-6 py-4 bg-gold text-navy text-base font-heading font-bold uppercase tracking-wider rounded-sm hover:bg-gold-light transition-colors duration-200">
        {currentLang === 'es' ? 'Consulta Gratis' : currentLang === 'en' ? 'Free Consultation' : 'Consulta gratuita'}
      </a>
      <div class="flex items-center justify-center gap-3 py-1" aria-label="Cambiar idioma">
        <a href={langLinks.es} class={`text-sm font-heading font-semibold uppercase tracking-widest ${currentLang === 'es' ? 'text-gold' : 'text-white/50 hover:text-white'}`}>ES</a>
        <span class="text-white/30">|</span>
        <a href={langLinks.en} class={`text-sm font-heading font-semibold uppercase tracking-widest ${currentLang === 'en' ? 'text-gold' : 'text-white/50 hover:text-white'}`}>EN</a>
        <span class="text-white/30">|</span>
        <a href={langLinks.pt} class={`text-sm font-heading font-semibold uppercase tracking-widest ${currentLang === 'pt' ? 'text-gold' : 'text-white/50 hover:text-white'}`}>PT</a>
      </div>
    </div>
  </nav>
</div>

{!isHomePage && <div class="h-[calc(var(--header-height)+var(--header-top-padding))]" aria-hidden="true"></div>}

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const closeBtn = document.getElementById('mobile-menu-close');
  const menu = document.getElementById('mobile-menu');
  const lines = toggle?.querySelectorAll('.hamburger-line');

  function openMenu() {
    menu?.classList.remove('hidden');
    toggle?.setAttribute('aria-expanded', 'true');
    lines?.[0]?.classList.add('rotate-45', 'translate-y-2');
    lines?.[1]?.classList.add('opacity-0');
    lines?.[2]?.classList.add('-rotate-45', '-translate-y-2');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    menu?.classList.add('hidden');
    toggle?.setAttribute('aria-expanded', 'false');
    lines?.[0]?.classList.remove('rotate-45', 'translate-y-2');
    lines?.[1]?.classList.remove('opacity-0');
    lines?.[2]?.classList.remove('-rotate-45', '-translate-y-2');
    document.body.style.overflow = '';
  }

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('hidden') === false;
    isOpen ? closeMenu() : openMenu();
  });

  closeBtn?.addEventListener('click', closeMenu);
  menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
  window.addEventListener('resize', () => { if (window.innerWidth >= 1024) closeMenu(); });

  const header = document.getElementById('site-header');
  const handleScroll = () => {
    if (window.scrollY > 20) header?.classList.add('scrolled');
    else header?.classList.remove('scrolled');
  };
  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();
</script>

<style>
  #site-header { background-color: transparent; font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; }
  #site-header.scrolled {
    background-color: var(--color-navy);
    backdrop-filter: blur(10px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }
</style>
