---
interface Props {
  variant?: 'default' | 'bordered' | 'navy' | 'elevated';
  padding?: 'sm' | 'md' | 'lg' | 'none';
  class?: string;
  hover?: boolean;
}

const {
  variant = 'default',
  padding = 'md',
  class: className = '',
  hover = false,
} = Astro.props;

const variantClasses = {
  default: 'bg-white',
  bordered: 'bg-white border border-gray-mid',
  navy: 'bg-navy text-white',
  elevated: 'bg-white shadow-md',
};

const paddingClasses = {
  none: '',
  sm: 'p-4',
  md: 'p-6',
  lg: 'p-8',
};

const hoverClasses = hover
  ? 'transition-all duration-200 hover:shadow-lg hover:-translate-y-0.5 cursor-pointer'
  : '';

const classes = `rounded-sm ${variantClasses[variant]} ${paddingClasses[padding]} ${hoverClasses} ${className}`;
---

<div class={classes}>
  <slot />
</div>
