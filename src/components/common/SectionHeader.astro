---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center' | 'right';
  theme?: 'light' | 'dark';
  class?: string;
}

const {
  eyebrow,
  title,
  subtitle,
  align = 'center',
  theme = 'light',
  class: className = '',
} = Astro.props;

const alignClasses = {
  left: 'text-left',
  center: 'text-center mx-auto',
  right: 'text-right ml-auto',
};

const titleColor = theme === 'dark' ? 'text-white' : 'text-navy';
const eyebrowColor = theme === 'dark' ? 'text-gold' : 'text-gold-dark';
const subtitleColor = theme === 'dark' ? 'text-white/70' : 'text-gray-text';
---

<div class={`max-w-3xl mb-12 ${alignClasses[align]} ${className}`}>
  {eyebrow && (
    <p class={`text-xs font-heading font-semibold uppercase tracking-widest mb-3 ${eyebrowColor}`}>
      {eyebrow}
    </p>
  )}
  <h2 class={`font-heading font-bold text-2xl md:text-3xl lg:text-4xl leading-tight ${titleColor}`}>
    {title}
  </h2>
  {subtitle && (
    <p class={`mt-4 text-base md:text-lg leading-relaxed ${subtitleColor}`}>
      {subtitle}
    </p>
  )}
</div>
