---
interface Props {
  name: string;
  size?: number | string;
  class?: string;
  'aria-hidden'?: boolean;
  'aria-label'?: string;
}

const {
  name,
  size = 24,
  class: className = '',
  'aria-hidden': ariaHidden = true,
  'aria-label': ariaLabel,
} = Astro.props;

// Lee el SVG desde los assets
let svgContent = '';
try {
  const svgFiles = import.meta.glob('/src/assets/icons/*.svg', { query: '?raw', import: 'default', eager: true });
  const key = `/src/assets/icons/${name}.svg`;
  if (key in svgFiles) {
    svgContent = svgFiles[key] as string;
    // Inyectar clases y tamaño al SVG
    svgContent = svgContent
      .replace('<svg', `<svg class="${className}" width="${size}" height="${size}"`)
      .replace(/width="\d+"/, `width="${size}"`)
      .replace(/height="\d+"/, `height="${size}"`);
  }
} catch (e) {
  // fallback silencioso
}
---

{svgContent ? (
  <span
    role={ariaHidden ? 'presentation' : 'img'}
    aria-hidden={ariaHidden ? 'true' : undefined}
    aria-label={ariaLabel}
    set:html={svgContent}
  />
) : (
  <span
    class={`inline-block ${className}`}
    style={`width:${size}px;height:${size}px`}
    aria-hidden="true"
  />
)}
