---
import type { CollectionEntry } from 'astro:content';
import SectionHeader from '@components/common/SectionHeader.astro';
import type { Lang } from '@lib/i18n';
import { useTranslations } from '@lib/i18n';

interface Props {
  members: CollectionEntry<'team'>[];
  lang?: Lang;
}

const { members, lang = 'es' } = Astro.props;
const t = useTranslations(lang);
const sorted = [...members].sort((a, b) => a.data.order - b.data.order);
const featuredMember = sorted.find(member => member.data.featured) ?? sorted[0];
const featuredBodyEn: Record<string, string> = {
  fundador: 'I am a Notary Public graduated from CLAEH Law School with more than six years of professional practice. As the firm’s founder and director, I focus on real estate and civil law from Punta del Este. For three years, I was part of the Law of Obligations chair at Universidad CLAEH, and I advise clients throughout Latin America, especially Argentine investors choosing Uruguay for their projects.',
};
const featuredBodyPt: Record<string, string> = {
  fundador: 'Sou Escrivão Público formado pela Faculdade de Direito do CLAEH, com mais de seis anos de prática profissional. Como diretor e fundador da firma, sou especializado em real estate e direito civil, com base em Punta del Este. Durante três anos integrei a cátedra de Direito das Obrigações na Universidade CLAEH e assessoro clientes de toda a América Latina, com foco especial em investidores argentinos que escolhem o Uruguai para seus projetos.',
};
const featuredText = featuredMember
  ? (lang === 'en'
      ? (featuredBodyEn[featuredMember.id] ?? featuredMember.body)
      : lang === 'pt'
        ? (featuredBodyPt[featuredMember.id] ?? featuredMember.body)
        : featuredMember.body)
  : '';
const featuredSummary = featuredText
  .split('. ')
  .slice(0, 2)
  .join('. ')
  .trim()
  + (featuredText.split('. ').length > 2 ? '.' : '');
---

<section id="equipo" class="section-padding bg-white">
  <div class="container-main">

    <SectionHeader
      eyebrow={t('team.eyebrow')}
      title={t('team.title')}
      subtitle={t('team.subtitle')}
      align="center"
      theme="light"
    />

    {featuredMember && (
      <article class="mx-auto max-w-5xl border border-gray-mid rounded-sm overflow-hidden bg-white shadow-sm">
        <div class="grid grid-cols-1 md:grid-cols-2">
          <div class="relative min-h-[320px] md:min-h-[420px] bg-navy/10">
            {featuredMember.data.photo ? (
              <img
                src={featuredMember.data.photo}
                alt={`Foto de ${featuredMember.data.name}`}
                class="w-full h-full object-cover object-top"
                loading="lazy"
                width="700"
                height="840"
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-navy to-navy-mid">
                <svg class="w-20 h-20 text-white/20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
                </svg>
              </div>
            )}
          </div>

          <div class="p-8 md:p-10 flex flex-col justify-center">
            <p class="text-gold text-xs font-heading font-semibold uppercase tracking-widest mb-2">
              {featuredMember.data.role}
            </p>
            <h3 class="font-heading font-bold text-navy text-2xl md:text-3xl leading-tight mb-3">
              {featuredMember.data.name}
            </h3>
            <p class="text-navy/80 font-medium text-sm mb-4">
              {featuredMember.data.specialization}
            </p>
            <p class="text-gray-text text-sm leading-relaxed mb-6 md:hidden">
              {featuredSummary}
            </p>
            <p class="text-gray-text text-sm leading-relaxed mb-6 hidden md:block">
              {featuredText}
            </p>

            <div>
              <a
                href={lang === 'en' ? '/en/about#team' : lang === 'pt' ? '/pt/sobre#team' : '/nosotros#equipo'}
                class="inline-flex items-center gap-2 px-8 py-4 border-2 border-navy text-navy text-sm font-heading font-bold uppercase tracking-widest rounded-sm hover:bg-navy hover:text-white transition-colors duration-200"
              >
                {t('team.cta')}
              </a>
            </div>
          </div>
        </div>
      </article>
    )}

  </div>
</section>
