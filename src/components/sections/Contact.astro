---
import type { Lang } from '@lib/i18n';
import { useTranslations } from '@lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const whatsappNumber = '5491100000000'; // Reemplazar con número real
const whatsappMessage = t('contact.whatsapp.message');
const emailSubject = lang === 'en' ? 'Legal%20Inquiry' : 'Consulta%20Jur%C3%ADdica';
const email = 'contacto@mecolestudio.com.ar';
---

<section id="contacto" class="section-padding bg-navy" aria-label={lang === 'en' ? 'Contact' : 'Contacto'}>
  <div class="container-main">

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">

      <!-- Información de contacto -->
      <div>
        <p class="text-gold text-xs font-heading font-semibold uppercase tracking-[0.25em] mb-3">
          {t('contact.eyebrow')}
        </p>
        <h2 class="font-heading font-bold text-3xl md:text-4xl text-white uppercase tracking-wide mb-4">
          {t('contact.title')}
        </h2>
        <p class="text-white/60 text-base leading-relaxed mb-10">
          {t('contact.description')}
        </p>

        <!-- Datos de contacto -->
        <address class="not-italic flex flex-col gap-6 mb-10">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-white/10 rounded-sm flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-gold" aria-hidden="true">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <div>
              <p class="text-white/40 text-xs uppercase tracking-wider mb-1 font-heading">{t('contact.address.label')}</p>
              <p class="text-white text-sm leading-relaxed">{t('contact.address.value')}</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-white/10 rounded-sm flex items-center justify-center flex-shrink-0">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-gold" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.41 2 2 0 0 1 3.6 1.23h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.18 6.18l.94-.94a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.73 16.92z"/>
              </svg>
            </div>
            <div>
              <p class="text-white/40 text-xs uppercase tracking-wider mb-1 font-heading">{t('contact.phone.label')}</p>
              <a href="tel:+5491100000000" class="text-white text-sm hover:text-gold transition-colors">
                +54 9 11 0000-0000
              </a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-white/10 rounded-sm flex items-center justify-center flex-shrink-0">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-gold" aria-hidden="true">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
              </svg>
            </div>
            <div>
              <p class="text-white/40 text-xs uppercase tracking-wider mb-1 font-heading">Email</p>
              <a href={`mailto:${email}`} class="text-white text-sm hover:text-gold transition-colors break-all">
                {email}
              </a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-white/10 rounded-sm flex items-center justify-center flex-shrink-0">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-gold" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/>
              </svg>
            </div>
            <div>
              <p class="text-white/40 text-xs uppercase tracking-wider mb-1 font-heading">{t('contact.hours.label')}</p>
              <p class="text-white text-sm">{t('contact.hours.value')}</p>
            </div>
          </div>
        </address>
      </div>

      <!-- CTAs de contacto directo -->
      <div class="lg:pt-20">
        <div class="bg-white/5 border border-white/10 rounded-sm p-8">
          <h3 class="font-heading font-bold text-white text-lg uppercase tracking-wide mb-2">
            {t('contact.cta.title')}
          </h3>
          <p class="text-white/50 text-sm leading-relaxed mb-8">
            {t('contact.cta.desc')}
          </p>

          <!-- WhatsApp (CTA principal) -->
          <a
            href={`https://wa.me/${whatsappNumber}?text=${whatsappMessage}`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-4 w-full p-5 bg-navy-mid hover:bg-navy-light rounded-sm mb-4 transition-colors duration-200 group"
            aria-label={lang === 'en' ? 'Contact via WhatsApp' : 'Contactar por WhatsApp'}
          >
            <div class="w-12 h-12 bg-white/20 rounded-sm flex items-center justify-center flex-shrink-0">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="white" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
              </svg>
            </div>
            <div class="flex-1">
              <p class="text-white font-heading font-bold text-sm uppercase tracking-wider">{t('contact.whatsapp')}</p>
              <p class="text-white/70 text-xs mt-0.5">{t('contact.whatsapp.response')}</p>
            </div>
            <svg class="w-5 h-5 text-white/60 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12,5 19,12 12,19"/>
            </svg>
          </a>

          <!-- Email -->
          <a
            href={`mailto:${email}?subject=${emailSubject}`}
            class="flex items-center gap-4 w-full p-5 bg-white/10 hover:bg-white/20 border border-white/10 rounded-sm transition-colors duration-200 group"
            aria-label={lang === 'en' ? 'Contact by email' : 'Contactar por email'}
          >
            <div class="w-12 h-12 bg-gold/20 rounded-sm flex items-center justify-center flex-shrink-0">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-gold" aria-hidden="true">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
              </svg>
            </div>
            <div class="flex-1">
              <p class="text-white font-heading font-bold text-sm uppercase tracking-wider">{t('contact.email')}</p>
              <p class="text-white/50 text-xs mt-0.5">{email}</p>
            </div>
            <svg class="w-5 h-5 text-white/30 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12,5 19,12 12,19"/>
            </svg>
          </a>

          <p class="text-center text-white/30 text-xs mt-6">
            {t('contact.disclaimer')}
          </p>
        </div>
      </div>

    </div>
  </div>
</section>
