---
import type { CollectionEntry } from 'astro:content';
import SectionHeader from '@components/common/SectionHeader.astro';
import ServiceCard from './ServiceCard.astro';
import type { Lang } from '@lib/i18n';
import { useTranslations } from '@lib/i18n';

interface Props {
  services: CollectionEntry<'services'>[];
  lang?: Lang;
}

const { services, lang = 'es' } = Astro.props;
const t = useTranslations(lang);
const sorted = [...services].sort((a, b) => a.data.order - b.data.order);
const serviceCopyEn: Record<string, { title: string; short: string }> = {
  '01-notarial-real-estate': { title: 'Notarial / Real Estate', short: 'Comprehensive real estate and notarial support for local and international investors in Uruguay.' },
  '02-residencias': { title: 'Residency', short: 'End-to-end legal and tax residency support in Uruguay for individuals and families.' },
  '03-servicios-contables': { title: 'Accounting Services', short: 'Full accounting, tax and payroll support with a preventive and compliance-focused approach.' },
  '04-compliance': { title: 'Compliance', short: 'Regulatory compliance programs tailored to each client’s AML/CFT risk profile.' },
  '05-inversiones': { title: 'Investments', short: 'Investment structuring with tax efficiency and asset protection at the core.' },
  '06-derecho-de-familia': { title: 'Family Law', short: 'Personal and estate-oriented family law advisory with focus on practical solutions.' },
  '07-derecho-del-trabajo': { title: 'Labor Law', short: 'Comprehensive labor advisory for employers and employees across individual and collective matters.' },
  '08-societario': { title: 'Corporate Law', short: 'Company setup, reorganization and governance across the full corporate lifecycle.' },
  '09-tributario': { title: 'Tax Law', short: 'Domestic and international tax planning and defense for individuals and companies.' },
  '10-derecho-civil': { title: 'Civil Law', short: 'Comprehensive advisory and representation in civil litigation, contracts and civil liability matters.' },
};

const servicesBaseUrl = lang === 'en' ? '/en/services' : '/servicios';
---

<section id="servicios" class="section-padding bg-gray-light">
  <div class="container-main">

    <SectionHeader
      eyebrow={t('services.eyebrow')}
      title={t('services.title')}
      subtitle={t('services.subtitle')}
      align="center"
      theme="light"
    />

    <!-- Grid de servicios -->
    <div class="services-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sorted.map((service, i) => (
        <div class="card-reveal service-item" style={`--delay: ${i * 100}ms`}>
          {(() => {
            const copy = lang === 'en'
              ? (serviceCopyEn[service.id] ?? { title: service.data.title, short: service.data.shortDescription })
              : { title: service.data.title, short: service.data.shortDescription };
            return (
          <ServiceCard
            title={copy.title}
            description={copy.short}
            icon={service.data.icon}
            href={`${servicesBaseUrl}/${service.id}`}
            featured={service.data.featured}
            lang={lang}
          />
            );
          })()}
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="cta-reveal text-center mt-12">
      <a
        href={servicesBaseUrl}
        class="services-cta-btn inline-flex items-center gap-2 px-8 py-4 bg-navy text-white text-sm font-heading font-bold uppercase tracking-widest rounded-sm hover:bg-navy-mid transition-colors duration-200"
      >
        {t('services.cta')}
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12,5 19,12 12,19"/>
        </svg>
      </a>
    </div>

  </div>
</section>

<style>
  .service-item:nth-child(n + 4) {
    display: none;
  }

  @media (min-width: 1024px) {
    .service-item:nth-child(-n + 6) {
      display: block;
    }

    .service-item:nth-child(n + 7) {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .services-cta-btn {
      animation: ctaPulse 2.8s ease-in-out infinite;
    }

    @keyframes ctaPulse {
      0%, 100% {
        box-shadow: 0 0 0 0 rgba(31, 43, 65, 0);
        transform: translateY(0);
      }
      50% {
        box-shadow: 0 0 0 10px rgba(31, 43, 65, 0.14);
        transform: translateY(-1px);
      }
    }

    .card-reveal {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 0.55s ease, transform 0.55s ease;
      transition-delay: var(--delay, 0ms);
    }

    .card-reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .cta-reveal {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.5s ease, transform 0.5s ease;
    }

    .cta-reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  const grid = document.querySelector('.services-grid');
  if (grid) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            // Animar cards
            grid.querySelectorAll('.card-reveal').forEach((card) => {
              card.classList.add('visible');
            });
            // Animar botón con delay extra tras la última card
            const cards = grid.querySelectorAll('.card-reveal');
            const lastDelay = (cards.length - 1) * 100 + 350;
            const cta = grid.closest('section')?.querySelector('.cta-reveal') as HTMLElement | null;
            if (cta) {
              setTimeout(() => cta.classList.add('visible'), lastDelay);
            }
            observer.disconnect();
          }
        });
      },
      { threshold: 0.1 }
    );
    observer.observe(grid);
  }
</script>
