---
interface Props {
  title: string;
  description: string;
  icon: string;
  href: string;
  featured?: boolean;
  lang?: 'es' | 'en' | 'pt';
}

const { title, description, icon, href, featured = false, lang = 'es' } = Astro.props;
const moreLabel = lang === 'en' ? 'View more' : lang === 'pt' ? 'Ver mais' : 'Ver más';
const ariaMoreLabel = lang === 'en'
  ? `View more about ${title}`
  : lang === 'pt'
    ? `Ver mais sobre ${title}`
    : `Ver más sobre ${title}`;
---

<article class={`
  group relative bg-white rounded-sm p-6 border border-gray-mid
  hover:shadow-lg hover:-translate-y-1 transition-all duration-300
  border-b-2 hover:border-b-gold
  ${featured ? 'border-b-gold' : 'border-b-transparent'}
`}>
  <!-- Ícono -->
  <div class={`
    w-12 h-12 rounded-sm flex items-center justify-center mb-4
    ${featured ? 'bg-gold text-navy' : 'bg-navy text-white group-hover:bg-gold group-hover:text-navy'}
    transition-colors duration-300
  `}>
    <!-- Íconos inline por nombre -->
    {icon === 'building' && (
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="1"/><path d="M9 22V12h6v10M3 9h18M3 15h18M9 3v6M15 3v6"/>
      </svg>
    )}
    {icon === 'file-text' && (
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
      </svg>
    )}
    {icon === 'users' && (
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
      </svg>
    )}
    {icon === 'scale' && (
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 3v18M3 9l9-6 9 6M5 21h14"/><path d="M4 9l-1 5c0 1.657 1.343 3 3 3s3-1.343 3-3L8 9M16 9l-1 5c0 1.657 1.343 3 3 3s3-1.343 3-3L19 9"/>
      </svg>
    )}
    {icon === 'home' && (
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9,22 9,12 15,12 15,22"/>
      </svg>
    )}
    {icon === 'gavel' && (
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M14 13l-8.5 8.5a2.121 2.121 0 0 1-3-3L11 10"/><path d="M18.5 8.5l1 1a2 2 0 0 1 0 2.828l-1.414 1.414a2 2 0 0 1-2.828 0l-4.5-4.5a2 2 0 0 1 0-2.828l1.414-1.414a2 2 0 0 1 2.828 0l1 1"/>
      </svg>
    )}
    {icon === 'globe' && (
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 0 20"/><path d="M12 2a15.3 15.3 0 0 0 0 20"/>
      </svg>
    )}
    {icon === 'shield' && (
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
      </svg>
    )}
    {icon === 'briefcase' && (
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/><path d="M2 12h20"/>
      </svg>
    )}
    {!['building','file-text','users','scale','home','gavel','globe','shield','briefcase'].includes(icon) && (
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/>
      </svg>
    )}
  </div>

  <!-- Título -->
  <h3 class="font-heading font-bold text-navy text-base uppercase tracking-wide mb-3 group-hover:text-navy-mid transition-colors">
    {title}
  </h3>

  <!-- Descripción -->
  <p class="text-gray-text text-sm leading-relaxed mb-5">
    {description}
  </p>

  <!-- Link -->
  <a
    href={href}
    class="inline-flex items-center gap-1.5 text-navy-mid text-xs font-heading font-semibold uppercase tracking-wider hover:text-gold transition-colors duration-200"
    aria-label={ariaMoreLabel}
  >
    {moreLabel}
    <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <line x1="5" y1="12" x2="19" y2="12"/>
      <polyline points="12,5 19,12 12,19"/>
    </svg>
  </a>
</article>
