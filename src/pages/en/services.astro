---
import PageLayout from '@layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const services = await getCollection('services', ({ data }) => !data.draft);
const sorted = services.sort((a, b) => a.data.order - b.data.order);
---

<PageLayout
  title="Services"
  description="MECOL ESTUDIO practice areas: corporate, contractual, labor, administrative, real estate law and dispute resolution."
  pageTitle="Our Practice Areas"
  pageSubtitle="Specialized legal solutions for every need."
  breadcrumb={[{ label: 'Home', href: '/en' }, { label: 'Services' }]}
>
  <section class="section-padding bg-white">
    <div class="container-main">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {sorted.map(service => (
          <div class="bg-white border border-gray-mid rounded-sm p-8 hover:shadow-lg transition-shadow">
            <h2 class="font-heading font-bold text-navy text-base uppercase tracking-wide mb-3">
              {service.data.title}
            </h2>
            <p class="text-gray-text text-sm leading-relaxed mb-5">
              {service.data.shortDescription}
            </p>
            <a href={`/servicios/${service.id}`} class="text-navy-mid hover:text-gold text-xs font-heading font-semibold uppercase tracking-wider transition-colors">
              View Details &rarr;
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>
</PageLayout>
