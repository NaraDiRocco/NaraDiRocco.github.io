---
import PageLayout from '@layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const members = await getCollection('team');
const sorted = members.sort((a, b) => a.data.order - b.data.order);

const teamBio: Record<string, string[]> = {
  'fundador': [
    'I am a Notary Public graduated from CLAEH Law School with more than six years of professional practice. As the firm’s founder and director, I focus on real estate and civil law from Punta del Este.',
    'For three years, I was part of the Law of Obligations chair at Universidad CLAEH, which strengthened both my academic background and my practical legal approach. I also trained in blockchain and smart contracts to stay aligned with legal innovation in the region.',
    'I advise clients throughout Latin America, especially Argentine investors choosing Uruguay for their projects, and I support each real estate venture from early structuring to final execution with legal certainty at every stage.',
    'I am fluent in Spanish, English and Portuguese, which allows me to provide personalized support to clients from different backgrounds.',
  ],
  'juan-gallegos-prieto': [
    'Notary Public with strong experience in strategic notarial advisory, legal certainty and real estate transactions.',
    'Focused on providing efficient, practical and close support, with personalized attention at every stage of the process.',
  ],
  'diego-mecol-pereira': [
    'Certified Public Accountant graduated from the Catholic University of Uruguay, with experience in accounting, taxation and financial management.',
    'He provides comprehensive advisory services to companies and professionals, helping them meet tax obligations, optimize management and support business growth with commitment and confidentiality.',
  ],
  'guillermo-rodriguez-montenegro': [
    'Certified Public Accountant graduated from the School of Economic Sciences and Administration at Universidad de la República (Uruguay), with experience in tax, labor and financial matters.',
    'He has professional background in public and private financial banking and in the retail sector, and currently also serves as an executive at Banco de la República.',
  ],
  'martina-martinez-ferreira': [
    'Attorney graduated from Universidad de la República Law School, with experience in civil law and litigation across different practice areas.',
    'Her work is defined by commitment, confidentiality and professional rigor, combining technical precision with close, personalized client support.',
  ],
};
---

<PageLayout
  title="About Us"
  description="Learn about MECOL ESTUDIO, our values, and our multidisciplinary team serving clients across Uruguay and the region."
  pageTitle="About Us"
  pageSubtitle="A comprehensive perspective for important decisions."
  breadcrumb={[{ label: 'Home', href: '/en' }, { label: 'About Us' }]}
>
  <section class="section-padding bg-white">
    <div class="container-main">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-gold-dark text-xs font-heading font-semibold uppercase tracking-[0.25em] mb-3">Our Story</p>
          <h2 class="font-heading font-bold text-3xl text-navy uppercase tracking-wide mb-6">A Firm Built with Purpose</h2>
          <div class="space-y-4 text-gray-text leading-relaxed">
            <p>MECOL ESTUDIO was founded on the belief that legal advisory must go beyond a one-time consultation. Since day one, we have focused on building long-term relationships and supporting clients through every stage of their growth.</p>
            <p>Our team integrates legal, notarial and accounting perspectives to deliver clear, coordinated and strategic solutions for business, personal and investment decisions.</p>
            <p>With active regional reach, we support clients across Uruguay and Latin America, especially in matters linked to real estate, structuring and cross-border advisory.</p>
          </div>
        </div>
        <div class="bg-gray-light rounded-sm p-8 border-l-4 border-gold">
          <blockquote class="text-navy font-heading font-medium text-xl leading-relaxed italic">"A comprehensive perspective for important decisions."</blockquote>
          <p class="text-gold-dark text-sm font-heading font-semibold mt-4">— MECOL ESTUDIO</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding bg-gray-light">
    <div class="container-main">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="font-heading font-bold text-3xl text-navy uppercase tracking-wide">Our Core</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {[
          {
            title: 'Mission',
            icon: 'target',
            text: 'To provide top-tier legal advisory that supports sustainable client growth through an integrated and strategic approach.',
          },
          {
            title: 'Vision',
            icon: 'globe',
            text: 'To be a leading legal firm in Uruguay and the region for clients seeking strategic, reliable and practical advisory.',
          },
          {
            title: 'Values',
            icon: 'shield',
            text: 'Integrity, technical excellence, client commitment, confidentiality and results-oriented execution guide everything we do.',
          },
        ].map(item => (
          <div class="bg-white rounded-sm p-8 shadow-sm border-t-4 border-gold text-center">
            <div class="w-14 h-14 bg-navy rounded-sm flex items-center justify-center mx-auto mb-4" aria-hidden="true">
              {item.icon === 'target' && (
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-gold">
                  <circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="2"/>
                </svg>
              )}
              {item.icon === 'globe' && (
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-gold">
                  <circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 0 20"/><path d="M12 2a15.3 15.3 0 0 0 0 20"/>
                </svg>
              )}
              {item.icon === 'shield' && (
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-gold">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
              )}
            </div>
            <h3 class="font-heading font-bold text-navy text-lg uppercase tracking-wide mb-4">{item.title}</h3>
            <p class="text-gray-text text-sm leading-relaxed">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="team" class="section-padding bg-white">
    <div class="container-main">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <p class="text-gold-dark text-xs font-heading font-semibold uppercase tracking-[0.25em] mb-3">Our Team</p>
        <h2 class="font-heading font-bold text-3xl text-navy uppercase tracking-wide">Professionals Committed to Excellence</h2>
        <div class="w-16 h-0.5 bg-gold mx-auto mt-6"></div>
      </div>

      <div class="grid grid-cols-1 gap-8">
        {sorted.map((member) => {
          const paragraphs = teamBio[member.id] ?? ['Professional profile available soon in English.'];
          const excerpt = paragraphs[0];
          const detailsId = `team-details-en-${member.id}`;
          return (
            <article class="flex flex-col md:flex-row md:items-stretch gap-8 p-8 bg-gray-light rounded-sm border border-gray-mid">
              <div class="flex-shrink-0 w-full md:w-56 lg:w-64">
                <div class="w-full h-64 md:h-full md:min-h-[280px] rounded-sm overflow-hidden bg-navy/10">
                  {member.data.photo ? (
                    <img src={member.data.photo} alt={`Photo of ${member.data.name}`} class="w-full h-full object-cover object-top" loading="lazy" />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-navy to-navy-mid">
                      <svg class="w-16 h-16 text-white/20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/></svg>
                    </div>
                  )}
                </div>
              </div>

              <div class="flex-1">
                <h3 class="font-heading font-bold text-navy text-xl mb-1">{member.data.name}</h3>
                <p class="text-gold font-heading font-semibold text-xs uppercase tracking-widest mb-1">{member.data.role}</p>
                <p class="text-gray-text text-sm mb-4">{member.data.specialization}</p>
                <p class="text-gray-text text-sm leading-relaxed mb-4">{excerpt}</p>

                <div id={detailsId} class="prose-mecol text-sm mb-4 hidden">
                  {paragraphs.slice(1).map((paragraph) => <p>{paragraph}</p>)}
                </div>

                <button
                  type="button"
                  class="team-toggle inline-flex items-center gap-1.5 text-navy-mid hover:text-navy text-xs font-heading font-semibold uppercase tracking-wider transition-colors"
                  data-target={detailsId}
                  aria-expanded="false"
                >
                  View full profile
                </button>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</PageLayout>

<script>
  document.querySelectorAll('.team-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');
      if (!targetId) return;
      const details = document.getElementById(targetId);
      if (!details) return;

      const isHidden = details.classList.contains('hidden');
      details.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
      btn.textContent = isHidden ? 'Hide full profile' : 'View full profile';
    });
  });
</script>
