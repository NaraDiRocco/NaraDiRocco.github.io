---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/sections/Hero.astro';
import Services from '@components/sections/Services.astro';
import WorkProcess from '@components/sections/WorkProcess.astro';
import Team from '@components/sections/Team.astro';
import Trust from '@components/sections/Trust.astro';
import RegionalMap from '@components/sections/RegionalMap.astro';
import Contact from '@components/sections/Contact.astro';
import { getCollection } from 'astro:content';

const services = await getCollection('services', ({ data }) => !data.draft);
const team = await getCollection('team');
---

<BaseLayout
  title="MECOL ESTUDIO"
  description="Law firm specialized in corporate, labor, and contractual law. Comprehensive legal counsel for businesses and individuals in Argentina and the region."
  canonicalURL="https://mecolestudio.com.ar/en"
>
  <Hero lang="en" />
  <Services services={services} lang="en" />
  <WorkProcess lang="en" />
  <Team members={team} lang="en" />
  <Trust lang="en" />
  <RegionalMap lang="en" />
  <Contact lang="en" />
</BaseLayout>
