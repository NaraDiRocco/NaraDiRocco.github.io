---
import PageLayout from '@layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const services = await getCollection('services', ({ data }) => !data.draft);
const sorted = services.sort((a, b) => a.data.order - b.data.order);
---

<PageLayout
  title="Servicios"
  description="Áreas de práctica de MECOL ESTUDIO: derecho societario, contractual, laboral, administrativo, inmobiliario y resolución de conflictos."
  pageTitle="Nuestras Áreas de Práctica"
  pageSubtitle="Soluciones jurídicas especializadas para cada necesidad."
  breadcrumb={[{ label: 'Inicio', href: '/' }, { label: 'Servicios' }]}
>
  <section class="section-padding bg-white">
    <div class="container-main">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {sorted.map(service => (
          <a
            href={`/servicios/${service.id}`}
            class="group bg-white border border-gray-mid rounded-sm p-8 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 border-b-2 border-b-transparent hover:border-b-gold flex flex-col"
          >
            <div class="w-12 h-12 bg-navy group-hover:bg-gold rounded-sm flex items-center justify-center mb-5 transition-colors duration-300">
              <svg class="text-white group-hover:text-navy w-6 h-6 transition-colors duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="1"/>
              </svg>
            </div>
            <h2 class="font-heading font-bold text-navy text-base uppercase tracking-wide mb-3">
              {service.data.title}
            </h2>
            <p class="text-gray-text text-sm leading-relaxed flex-1">
              {service.data.shortDescription}
            </p>
            <div class="mt-5 flex items-center gap-1.5 text-navy-mid group-hover:text-gold text-xs font-heading font-semibold uppercase tracking-wider transition-colors">
              Ver detalle
              <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12,5 19,12 12,19"/>
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding-sm bg-navy">
    <div class="container-main text-center">
      <h2 class="font-heading font-bold text-white text-2xl uppercase tracking-wide mb-4">
        ¿No encontrás lo que buscás?
      </h2>
      <p class="text-white/60 mb-8">Consultanos directamente, atendemos necesidades específicas de cada cliente.</p>
      <a
        href="/contacto"
        class="inline-flex items-center gap-2 px-8 py-4 bg-gold text-navy text-sm font-heading font-bold uppercase tracking-widest rounded-sm hover:bg-gold-light transition-colors"
      >
        Consultar ahora
      </a>
    </div>
  </section>
</PageLayout>
