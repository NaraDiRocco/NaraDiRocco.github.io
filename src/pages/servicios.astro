---
import PageLayout from '@layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import Icon from '@components/common/Icon.astro';

const services = await getCollection('services', ({ data }) => !data.draft);
const sorted = services.sort((a, b) => a.data.order - b.data.order);
---

<PageLayout
  title="Áreas de Práctica"
  description="Áreas de práctica de MECOL ESTUDIO: notarial y real estate, residencias, servicios contables, compliance, inversiones, familia, laboral, societario y tributario."
  pageTitle="Nuestras Áreas de Práctica"
  pageSubtitle="Asesoramiento integral en áreas legales, notariales, contables y patrimoniales."
  breadcrumb={[{ label: 'Inicio', href: '/' }, { label: 'Áreas de práctica' }]}
>
  <section class="section-padding bg-white">
    <div class="container-main">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {sorted.map((service, i) => (
          <a
            href={`/servicios/${service.id}`}
            class="group area-card bg-white border border-gray-mid rounded-sm p-8 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 border-b-2 border-b-gold flex flex-col"
            style={`--delay: ${i * 90}ms`}
          >
            <div class="w-12 h-12 bg-navy group-hover:bg-gold rounded-sm flex items-center justify-center mb-5 transition-colors duration-300">
              <Icon
                name={service.data.icon}
                size={24}
                class="text-white group-hover:text-navy transition-colors duration-300"
                aria-hidden={true}
              />
            </div>
            <h2 class="font-heading font-bold text-navy text-base uppercase tracking-wide mb-3">
              {service.data.title}
            </h2>
            <p class="text-gray-text text-sm leading-relaxed flex-1">
              {service.data.shortDescription}
            </p>
            <div class="mt-5 flex items-center gap-1.5 text-navy-mid group-hover:text-gold text-xs font-heading font-semibold uppercase tracking-wider transition-colors">
              Ver área
              <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12,5 19,12 12,19"/>
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding-sm bg-navy">
    <div class="container-main text-center">
      <h2 class="font-heading font-bold text-white text-2xl uppercase tracking-wide mb-4">
        ¿Querés asesoramiento específico?
      </h2>
      <p class="text-white/60 mb-8">Escribinos y te orientamos según tu situación y objetivos.</p>
      <a
        href="/contacto"
        class="consultar-btn inline-flex items-center gap-2 px-8 py-4 bg-gold text-navy text-sm font-heading font-bold uppercase tracking-widest rounded-sm hover:bg-gold-light transition-colors"
      >
        Consultar ahora
      </a>
    </div>
    <div class="w-[80%] mx-auto mt-14 border-b border-white/20" aria-hidden="true"></div>
  </section>
</PageLayout>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .consultar-btn {
      animation: ctaPulse 2.8s ease-in-out infinite;
    }

    @keyframes ctaPulse {
      0%, 100% {
        transform: translateY(0);
        box-shadow: 0 0 0 0 rgba(162, 187, 211, 0);
      }
      50% {
        transform: translateY(-1px);
        box-shadow: 0 0 0 10px rgba(162, 187, 211, 0.25);
      }
    }

    .area-card {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.55s ease, transform 0.55s ease;
      transition-delay: var(--delay, 0ms);
    }

    .area-card.visible {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  const cards = document.querySelectorAll('.area-card');

  if (cards.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 }
    );

    cards.forEach((card) => observer.observe(card));
  }
</script>
