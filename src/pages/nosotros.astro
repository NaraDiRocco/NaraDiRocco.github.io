---
import PageLayout from '@layouts/PageLayout.astro';
import { getCollection, render } from 'astro:content';

const members = await getCollection('team');
const sorted = members.sort((a, b) => a.data.order - b.data.order);
---

<PageLayout
  title="Nosotros"
  description="Conocé la historia, misión, valores y el equipo de MECOL ESTUDIO. Profesionales comprometidos con la excelencia jurídica y el acompañamiento estratégico."
  pageTitle="Nosotros"
  pageSubtitle="Una mirada integral para decisiones importantes."
  breadcrumb={[{ label: 'Inicio', href: '/' }, { label: 'Nosotros' }]}
>
  <!-- Historia del estudio -->
  <section class="section-padding bg-white">
    <div class="container-main">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-gold-dark text-xs font-heading font-semibold uppercase tracking-[0.25em] mb-3">
            Nuestra Historia
          </p>
          <h2 class="font-heading font-bold text-3xl text-navy uppercase tracking-wide mb-6">
            Un Estudio Fundado con Propósito
          </h2>
          <div class="space-y-4 text-gray-text leading-relaxed">
            <p>
              MECOL ESTUDIO nació de la convicción de que el asesoramiento jurídico debe ir más allá de la consulta puntual. Desde nuestra fundación, nos hemos enfocado en construir relaciones de largo plazo con nuestros clientes, acompañándolos en cada etapa de su desarrollo.
            </p>
            <p>
              Con más de 15 años de trayectoria, hemos desarrollado una práctica sólida en las áreas más relevantes del derecho empresarial: societario, contractual, laboral, administrativo e inmobiliario.
            </p>
            <p>
              Nuestra presencia se extiende en Argentina y en la región latinoamericana, ofreciendo a nuestros clientes la posibilidad de contar con asesoramiento integral independientemente de las fronteras.
            </p>
          </div>
        </div>
        <div class="bg-gray-light rounded-sm p-8 border-l-4 border-gold">
          <blockquote class="text-navy font-heading font-medium text-xl leading-relaxed italic">
            "Una mirada integral para decisiones importantes."
          </blockquote>
          <p class="text-gold-dark text-sm font-heading font-semibold mt-4">
            — MECOL ESTUDIO
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Misión, Visión, Valores -->
  <section class="section-padding bg-gray-light">
    <div class="container-main">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="font-heading font-bold text-3xl text-navy uppercase tracking-wide">
          Nuestra Esencia
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {[
          {
            title: 'Misión',
            icon: 'target',
            text: 'Brindar asesoramiento jurídico de excelencia que contribuya al crecimiento sostenible de nuestros clientes, con un enfoque estratégico e integral.',
          },
          {
            title: 'Visión',
            icon: 'globe',
            text: 'Ser el estudio jurídico de referencia en Argentina y la región para empresas que buscan un acompañamiento legal estratégico y comprometido.',
          },
          {
            title: 'Valores',
            icon: 'shield',
            text: 'Integridad, excelencia técnica, compromiso con el cliente, confidencialidad y orientación a resultados son los pilares de nuestra práctica profesional.',
          },
        ].map(item => (
          <div class="bg-white rounded-sm p-8 shadow-sm border-t-4 border-gold text-center">
            <div class="w-14 h-14 bg-navy rounded-sm flex items-center justify-center mx-auto mb-4" aria-hidden="true">
              {item.icon === 'target' && (
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-gold">
                  <circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="2"/>
                </svg>
              )}
              {item.icon === 'globe' && (
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-gold">
                  <circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 0 20"/><path d="M12 2a15.3 15.3 0 0 0 0 20"/>
                </svg>
              )}
              {item.icon === 'shield' && (
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-gold">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
              )}
            </div>
            <h3 class="font-heading font-bold text-navy text-lg uppercase tracking-wide mb-4">
              {item.title}
            </h3>
            <p class="text-gray-text text-sm leading-relaxed">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Por qué elegirnos -->
  <section class="section-padding bg-navy">
    <div class="container-main">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="font-heading font-bold text-3xl text-white uppercase tracking-wide">
          Por Qué Elegirnos
        </h2>
        <div class="w-16 h-0.5 bg-gold mx-auto mt-4"></div>
      </div>
      <div class="mobile-why-carousel flex md:grid md:grid-cols-2 lg:grid-cols-4 gap-6 overflow-x-auto md:overflow-visible pb-2 md:pb-0 -mx-1 px-1 md:mx-0 md:px-0">
        {[
          { title: 'Experiencia Comprobada', text: 'Más de 15 años asesorando empresas y particulares.' },
          { title: 'Visión Integral', text: 'Abordamos cada caso desde todas sus perspectivas jurídicas.' },
          { title: 'Alcance Regional', text: 'Presencia activa en Argentina y el Cono Sur.' },
          { title: 'Atención Personalizada', text: 'Cada cliente recibe atención directa de nuestros socios.' },
        ].map(item => (
          <div class="mobile-why-card min-w-full md:min-w-0 bg-white/5 border border-white/10 rounded-sm p-6 snap-center">
            <div class="w-8 h-0.5 bg-gold mb-4"></div>
            <h3 class="font-heading font-bold text-white text-sm uppercase tracking-wider mb-3">
              {item.title}
            </h3>
            <p class="text-white/50 text-sm leading-relaxed">{item.text}</p>
          </div>
        ))}
      </div>
      <div class="mobile-why-dots md:hidden flex justify-center gap-2 mt-4" aria-hidden="true">
        <span class="mobile-why-dot w-2 h-2 rounded-full bg-white"></span>
        <span class="mobile-why-dot w-2 h-2 rounded-full bg-white/35"></span>
        <span class="mobile-why-dot w-2 h-2 rounded-full bg-white/35"></span>
        <span class="mobile-why-dot w-2 h-2 rounded-full bg-white/35"></span>
      </div>
    </div>
  </section>

  <!-- Nuestro Equipo -->
  <section id="equipo" class="section-padding bg-white">
    <div class="container-main">

      <div class="text-center max-w-2xl mx-auto mb-12">
        <p class="text-gold-dark text-xs font-heading font-semibold uppercase tracking-[0.25em] mb-3">
          Nuestro Equipo
        </p>
        <h2 class="font-heading font-bold text-3xl text-navy uppercase tracking-wide">
          Profesionales Comprometidos con la Excelencia
        </h2>
        <div class="w-16 h-0.5 bg-gold mx-auto mt-6"></div>
      </div>

      <div class="grid grid-cols-1 gap-8">
        {sorted.map(async (member) => {
          const { Content } = await render(member);
          const firstBlock = member.body.trim().split('\n\n')[0] ?? '';
          const excerpt = firstBlock
            .replaceAll('**', '')
            .replaceAll('*', '')
            .replaceAll('`', '')
            .replaceAll('#', '')
            .trim();
          const detailsId = `member-details-${member.id}`;
          return (
            <article class="flex flex-col md:flex-row md:items-stretch gap-8 p-8 bg-gray-light rounded-sm border border-gray-mid">
              <!-- Foto -->
              <div class="flex-shrink-0 w-full md:w-56 lg:w-64">
                <div class="w-full h-64 md:h-full md:min-h-[280px] rounded-sm overflow-hidden bg-navy/10">
                  {member.data.photo ? (
                    <img
                      src={member.data.photo}
                      alt={`Foto de ${member.data.name}`}
                      class="w-full h-full object-cover object-top"
                      loading="lazy"
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-navy to-navy-mid">
                      <svg class="w-16 h-16 text-white/20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
                      </svg>
                    </div>
                  )}
                </div>
              </div>

              <!-- Info -->
              <div class="flex-1">
                <h3 class="font-heading font-bold text-navy text-xl mb-1">
                  {member.data.name}
                </h3>
                <p class="text-gold font-heading font-semibold text-xs uppercase tracking-widest mb-1">
                  {member.data.role}
                </p>
                <p class="text-gray-text text-sm mb-4">{member.data.specialization}</p>

                <p class="text-gray-text text-sm leading-relaxed mb-4">
                  {excerpt}
                </p>

                <div id={detailsId} class="prose-mecol text-sm mb-4 hidden">
                  <Content />
                </div>

                <button
                  type="button"
                  class="team-toggle inline-flex items-center gap-1.5 text-navy-mid hover:text-navy text-xs font-heading font-semibold uppercase tracking-wider transition-colors"
                  data-target={detailsId}
                  aria-expanded="false"
                >
                  Ver perfil completo
                </button>
              </div>
            </article>
          );
        })}
      </div>

    </div>
  </section>
</PageLayout>

<style>
  .mobile-why-carousel {
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .mobile-why-carousel::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  const mobileCarousel = document.querySelector('.mobile-why-carousel');
  const mobileCards = mobileCarousel?.querySelectorAll('.mobile-why-card');
  const dots = document.querySelectorAll('.mobile-why-dot');

  if (mobileCarousel && mobileCards && mobileCards.length > 1) {
    let currentIndex = 0;
    const total = mobileCards.length;

    const goToCard = (index) => {
      const target = mobileCards[index];
      if (!target) return;
      mobileCarousel.scrollTo({
        left: target.offsetLeft - mobileCarousel.offsetLeft,
        behavior: 'smooth',
      });
      dots.forEach((dot, i) => {
        dot.classList.toggle('bg-white', i === index);
        dot.classList.toggle('bg-white/35', i !== index);
      });
    };

    const startAutoSlide = () => {
      return setInterval(() => {
        if (window.innerWidth >= 768) return;
        currentIndex = (currentIndex + 1) % total;
        goToCard(currentIndex);
      }, 3200);
    };

    let timer = startAutoSlide();

    mobileCarousel.addEventListener('pointerdown', () => clearInterval(timer));
    mobileCarousel.addEventListener('pointerup', () => { timer = startAutoSlide(); });
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768) clearInterval(timer);
      else {
        clearInterval(timer);
        timer = startAutoSlide();
      }
    });
  }
</script>

<script>
  document.querySelectorAll('.team-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');
      if (!targetId) return;
      const details = document.getElementById(targetId);
      if (!details) return;

      const isHidden = details.classList.contains('hidden');
      details.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
      btn.textContent = isHidden ? 'Ocultar perfil completo' : 'Ver perfil completo';
    });
  });
</script>
