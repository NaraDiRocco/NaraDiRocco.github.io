---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscás no existe. Volvé al inicio de MECOL ESTUDIO."
>
  <section class="min-h-screen flex items-center justify-center bg-gray-light">
    <div class="container-main text-center py-20">
      <p class="font-heading font-bold text-8xl md:text-9xl text-navy/10 leading-none mb-4" aria-hidden="true">
        404
      </p>
      <div class="w-16 h-0.5 bg-gold mx-auto mb-6" aria-hidden="true"></div>
      <h1 class="font-heading font-bold text-2xl md:text-3xl text-navy uppercase tracking-wide mb-4">
        Página No Encontrada
      </h1>
      <p class="text-gray-text text-base leading-relaxed max-w-md mx-auto mb-10">
        La página que estás buscando no existe o fue movida. Podés volver al inicio o explorar nuestras secciones.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/"
          class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-navy text-white text-sm font-heading font-bold uppercase tracking-widest rounded-sm hover:bg-navy-mid transition-colors"
        >
          ← Volver al Inicio
        </a>
        <a
          href="/contacto"
          class="inline-flex items-center justify-center gap-2 px-8 py-4 border-2 border-navy text-navy text-sm font-heading font-bold uppercase tracking-widest rounded-sm hover:bg-navy hover:text-white transition-colors"
        >
          Ir a Contacto
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
