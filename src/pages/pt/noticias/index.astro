---
import PageLayout from '@layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '@lib/utils';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) =>
  new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

const postCopy: Record<string, { title: string; description: string; category: string; slug: string }> = {
  'que-es-una-sas': {
    title: 'O que é uma Sociedade por Ações Simplificada (SAS) e por que é destaque no empreendedorismo?',
    description: 'Cinco anos após sua implementação, a SAS se consolidou como uma estrutura societária ágil e flexível para empreender no Uruguai.',
    category: 'Notícias',
    slug: 'o-que-e-uma-sas',
  },
};
---

<PageLayout
  title="Notícias"
  description="Análises jurídicas, atualizações legislativas e jurisprudência relevante da MECOL ESTUDIO."
  pageTitle="Notícias"
  pageSubtitle="Análises jurídicas, legislação e atualizações jurisprudenciais."
  breadcrumb={[{ label: 'Início', href: '/pt' }, { label: 'Notícias' }]}
>
  <section class="section-padding bg-white">
    <div class="container-main">
      {posts.length === 0 ? (
        <div class="text-center py-20"><p class="text-gray-text text-lg">Publicaremos nossos artigos em breve.</p></div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map((post) => {
            const copy = postCopy[post.id] ?? {
              title: post.data.title,
              description: post.data.description,
              category: post.data.category,
              slug: post.id,
            };
            return (
              <article class="group bg-white border border-gray-mid rounded-sm overflow-hidden hover:shadow-lg transition-all duration-300">
                <div class="aspect-video bg-gradient-to-br from-navy to-navy-mid relative overflow-hidden">
                  <div class="absolute inset-0 flex items-center justify-center">
                    <span class="font-heading font-bold text-white/20 text-5xl uppercase tracking-widest">{copy.category?.[0] ?? 'N'}</span>
                  </div>
                </div>
                <div class="p-6">
                  <div class="flex items-center gap-3 mb-3 flex-wrap">
                    <span class="bg-gold text-navy text-[10px] font-heading font-bold uppercase tracking-wider px-2 py-0.5 rounded-sm">{copy.category}</span>
                    <time class="text-gray-text text-xs" datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time>
                  </div>
                  <h3 class="font-heading font-bold text-navy text-base leading-tight mb-2 group-hover:text-navy-mid transition-colors">
                    <a href={`/pt/noticias/${copy.slug}`} class="hover:underline">{copy.title}</a>
                  </h3>
                  <p class="text-gray-text text-sm leading-relaxed mb-4 line-clamp-3">{copy.description}</p>
                  <div class="flex items-center justify-between">
                    <span class="text-gray-text text-xs">{post.data.author}</span>
                    <a href={`/pt/noticias/${copy.slug}`} class="inline-flex items-center gap-1.5 text-navy-mid hover:text-gold text-xs font-heading font-semibold uppercase tracking-wider transition-colors">Ler →</a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      )}
    </div>
  </section>
</PageLayout>
