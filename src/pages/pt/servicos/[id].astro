    ],
  },
  '09-tributario': {
    title: 'Tributário',
    short: 'Planejamento e contencioso tributário nacional e internacional para pessoas e empresas.',
    body: [
      'Prestamos assessoria tributária integral em âmbito nacional e internacional para residentes e não residentes.',
      'Nossa prática inclui consultas vinculantes, representação em procedimentos administrativos e contencioso-tributários, além de suporte em fiscalizações.',
      'Também orientamos sobre tratados para evitar dupla tributação e regimes de transparência fiscal internacional, como CRS, FATCA e BEPS.',
    ],
  },
  '10-derecho-civil': {
    title: 'Direito Civil',
    short: 'Assessoria e patrocínio integral em processos civis, contratos e responsabilidade civil.',
    body: [
      'Assessoramos e patrocinamos nossos clientes em toda a gama de processos e operações de natureza civil, tanto na esfera contenciosa quanto voluntária.',
      'Nossa prática abrange escriturações judiciais e forçadas, prescrição extintiva e aquisitiva para regularização dominial de imóveis, além de ações reivindicatórias, possessórias e interditais.',
      'Também atuamos em ações de responsabilidade civil contratual e extracontratual para reparação de danos, bem como na redação e execução de contratos civis em geral.',
    ],
  },
};

export async function getStaticPaths() {
  const services = await getCollection('services', ({ data }) => !data.draft);
  return services.map((service) => ({ params: { id: service.id } }));
}

const { id } = Astro.params;
const content = id ? ptContent[id] : null;

if (!content) {
  throw new Error('Service not found');
}
---

<PageLayout
  title={content.title}
  description={content.short}
  pageTitle={content.title}
  pageSubtitle={content.short}
  breadcrumb={[
    { label: 'Início', href: '/pt' },
    { label: 'Áreas de prática', href: '/pt/servicos' },
    { label: content.title },
  ]}
>
  <section class="section-padding bg-white">
    <div class="container-main max-w-4xl">
      <div class="prose-mecol">
        {content.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <div class="mt-12 pt-8 border-t border-gray-mid flex flex-col sm:flex-row gap-4 items-start sm:items-center">
        <a href="https://wa.me/5491100000000" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 bg-navy text-white text-sm font-heading font-bold uppercase tracking-widest rounded-sm hover:bg-navy-mid transition-colors">
          Consultar sobre esta área
        </a>
        <a href="/pt/servicos" class="inline-flex items-center gap-2 text-navy-mid hover:text-navy text-sm font-heading font-semibold transition-colors">
          ← Ver todas as áreas
        </a>
      </div>
    </div>
  </section>
</PageLayout>
