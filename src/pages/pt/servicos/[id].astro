---
import PageLayout from '@layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const services = await getCollection('services', ({ data }) => !data.draft);

const ptContent: Record<string, { title: string; short: string; body: string[] }> = {
  '01-notarial-real-estate': {
    title: 'Notarial / Real Estate',
    short: 'Assessoria completa em operações imobiliárias e notariais para investidores locais e internacionais no Uruguai.',
