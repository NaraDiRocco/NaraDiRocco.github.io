---
import PageLayout from '@layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import Icon from '@components/common/Icon.astro';

const services = await getCollection('services', ({ data }) => !data.draft);
const sorted = services.sort((a, b) => a.data.order - b.data.order);

const t: Record<string, { title: string; short: string }> = {
  '01-notarial-real-estate': { title: 'Notarial / Real Estate', short: 'Comprehensive real estate and notarial support for local and international investors in Uruguay.' },
  '02-residencias': { title: 'Residency', short: 'End-to-end legal and tax residency support in Uruguay for individuals and families.' },
  '03-servicios-contables': { title: 'Accounting Services', short: 'Full accounting, tax and payroll support with a preventive and compliance-focused approach.' },
  '04-compliance': { title: 'Compliance', short: 'Regulatory compliance programs tailored to each client’s AML/CFT risk profile.' },
  '05-inversiones': { title: 'Investments', short: 'Investment structuring with tax efficiency and asset protection at the core.' },
  '06-derecho-de-familia': { title: 'Family Law', short: 'Personal and estate-oriented family law advisory with focus on practical solutions.' },
  '07-derecho-del-trabajo': { title: 'Labor Law', short: 'Comprehensive labor advisory for employers and employees across individual and collective matters.' },
  '08-societario': { title: 'Corporate Law', short: 'Company setup, reorganization and governance across the full corporate lifecycle.' },
  '09-tributario': { title: 'Tax Law', short: 'Domestic and international tax planning and defense for individuals and companies.' },
  '10-derecho-civil': { title: 'Civil Law', short: 'Comprehensive advisory and representation in civil litigation, contracts and civil liability matters.' },
};
---

<PageLayout
  title="Áreas de prática"
  description="Áreas de prática da MECOL ESTUDIO: notarial e real estate, residências, serviços contábeis, compliance, investimentos, família, trabalho, societário, tributário e direito civil."
  pageTitle="Áreas de prática"
  pageSubtitle="Assessoria integrada em temas jurídicos, notariais, contábeis e patrimoniais."
  breadcrumb={[{ label: 'Início', href: '/pt' }, { label: 'Áreas de prática' }]}
>
  <section class="section-padding bg-white">
    <div class="container-main">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {sorted.map((service, i) => {
          const copy = t[service.id] ?? { title: service.data.title, short: service.data.shortDescription };
          return (
            <a
              href={`/pt/servicos/${service.id}`}
              class="group area-card bg-white border border-gray-mid rounded-sm p-8 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 border-b-2 border-b-gold flex flex-col"
              style={`--delay: ${i * 90}ms`}
            >
              <div class="w-12 h-12 bg-navy group-hover:bg-gold rounded-sm flex items-center justify-center mb-5 transition-colors duration-300">
                <Icon name={service.data.icon} size={24} class="text-white group-hover:text-navy transition-colors duration-300" aria-hidden={true} />
              </div>
              <h2 class="font-heading font-bold text-navy text-base uppercase tracking-wide mb-3">{copy.title}</h2>
              <p class="text-gray-text text-sm leading-relaxed flex-1">{copy.short}</p>
              <div class="mt-5 flex items-center gap-1.5 text-navy-mid group-hover:text-gold text-xs font-heading font-semibold uppercase tracking-wider transition-colors">
                Ver área
                <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12,5 19,12 12,19"/>
                </svg>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section-padding-sm bg-navy">
    <div class="container-main text-center">
      <h2 class="font-heading font-bold text-white text-2xl uppercase tracking-wide mb-4">Precisa de assessoria personalizada?</h2>
      <p class="text-white/60 mb-8">Escreva para nós e orientaremos você de acordo com seu contexto e objetivos.</p>
      <a href="/pt/contato" class="consultar-btn inline-flex items-center gap-2 px-8 py-4 bg-gold text-navy text-sm font-heading font-bold uppercase tracking-widest rounded-sm hover:bg-gold-light transition-colors">Consultar agora</a>
    </div>
    <div class="w-[80%] mx-auto mt-14 border-b border-white/20" aria-hidden="true"></div>
  </section>
</PageLayout>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .consultar-btn { animation: ctaPulse 2.8s ease-in-out infinite; }
    @keyframes ctaPulse {
      0%, 100% { transform: translateY(0); box-shadow: 0 0 0 0 rgba(162, 187, 211, 0); }
      50% { transform: translateY(-1px); box-shadow: 0 0 0 10px rgba(162, 187, 211, 0.25); }
    }
    .area-card {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.55s ease, transform 0.55s ease;
      transition-delay: var(--delay, 0ms);
    }
    .area-card.visible { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  const cards = document.querySelectorAll('.area-card');
  if (cards.length) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    cards.forEach((card) => observer.observe(card));
  }
</script>
