---
import PageLayout from '@layouts/PageLayout.astro';

const whatsappNumber = '5491100000000';
const whatsappMessage = encodeURIComponent('Hola, me gustaría iniciar una consulta jurídica.');
const email = 'contacto@mecolestudio.com.ar';
---

<PageLayout
  title="Contacto"
  description="Contactá a MECOL ESTUDIO para asesoramiento jurídico. Estamos disponibles de lunes a viernes de 9 a 18 hs en Buenos Aires, Argentina."
  pageTitle="Contacto"
  pageSubtitle="Estamos disponibles para escucharte."
  breadcrumb={[{ label: 'Inicio', href: '/' }, { label: 'Contacto' }]}
>
  <!-- Sección principal de contacto -->
  <section class="section-padding bg-white">
    <div class="container-main">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">

        <!-- Info y formas de contacto -->
        <div>
          <h2 class="font-heading font-bold text-navy text-2xl uppercase tracking-wide mb-8">
            Iniciá tu Consulta
          </h2>

          <!-- WhatsApp -->
          <a
            href={`https://wa.me/${whatsappNumber}?text=${whatsappMessage}`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-5 p-6 bg-navy-mid text-navy rounded-sm mb-4 hover:bg-navy-light transition-all group"
          >
            <div class="w-14 h-14 bg-white/20 rounded-sm flex items-center justify-center flex-shrink-0">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="white" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
              </svg>
            </div>
            <div>
              <p class="text-white font-heading font-bold text-base uppercase tracking-wide">WhatsApp</p>
              <p class="text-white/80 text-sm">Respuesta inmediata · +54 9 11 0000-0000</p>
            </div>
            <svg class="w-6 h-6 text-white/60 ml-auto group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12,5 19,12 12,19"/>
            </svg>
          </a>

          <!-- Email -->
          <a
            href={`mailto:${email}?subject=Consulta%20Jurídica`}
            class="flex items-center gap-5 p-6 bg-gray-light border border-gray-mid rounded-sm mb-10 hover:bg-white hover:shadow-md transition-all group"
          >
            <div class="w-14 h-14 bg-navy rounded-sm flex items-center justify-center flex-shrink-0">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-gold" aria-hidden="true">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
              </svg>
            </div>
            <div>
              <p class="text-navy font-heading font-bold text-base uppercase tracking-wide">Email</p>
              <p class="text-gray-text text-sm">{email}</p>
            </div>
            <svg class="w-6 h-6 text-gray-text ml-auto group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12,5 19,12 12,19"/>
            </svg>
          </a>

          <!-- Datos de contacto -->
          <div class="space-y-5">
            <h3 class="font-heading font-bold text-navy text-sm uppercase tracking-widest mb-4">
              Información de Contacto
            </h3>
            {[
              {
                label: 'Dirección',
                value: 'Calle 10 y 11, oficina N.º 101 Edificio Gala Puerto. Punta del Este',
                icon: 'location',
              },
              {
                label: 'Teléfono',
                value: '+598 99 759 109',
                note: null,
                icon: 'phone',
              },
              {
                label: 'Contacto',
                value: 'info@mecolestudio.com',
                note: null,
                icon: 'email',
              },
              {
                label: 'Horario',
                value: '10 a 18 hs',
                note: null,
                icon: 'clock',
              },
            ].map(item => (
              <div class="flex items-start gap-4">
                <div class="w-8 h-8 bg-gold/10 rounded-sm flex items-center justify-center flex-shrink-0 mt-0.5">
                  <div class="w-2 h-2 bg-gold rounded-full"></div>
                </div>
                <div>
                  <p class="text-gray-text text-xs uppercase tracking-wider font-heading">{item.label}</p>
                  <p class="text-navy font-medium text-sm mt-0.5">{item.value}</p>
                  {item.note && <p class="text-gray-text text-xs italic mt-0.5">{item.note}</p>}
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- FAQ -->
        <div>
          <h2 class="font-heading font-bold text-navy text-2xl uppercase tracking-wide mb-8">
            Preguntas Frecuentes
          </h2>
          <div class="space-y-4">
            {[
              {
                q: '¿La consulta inicial tiene costo?',
                a: 'La primera consulta es gratuita y confidencial. Nuestro objetivo es entender tu situación y orientarte sobre las opciones disponibles.',
              },
              {
                q: '¿Trabajan con clientes de otras provincias o países?',
                a: 'Sí. Contamos con clientes en todo el país y en varios países de la región latinoamericana. Las consultas pueden realizarse de forma presencial o remota.',
              },
              {
                q: '¿En qué horario puedo contactarlos?',
                a: 'Atendemos de lunes a viernes de 9:00 a 18:00 hs. Para consultas urgentes, pueden contactarnos por WhatsApp.',
              },
              {
                q: '¿Cuánto demora en responderse una consulta?',
                a: 'Respondemos todas las consultas dentro de las 24 horas hábiles. Para urgencias, el canal de WhatsApp tiene respuesta más inmediata.',
              },
              {
                q: '¿Trabajan con empresas o también con particulares?',
                a: 'Trabajamos tanto con empresas de distintos tamaños como con personas particulares que necesitan asesoramiento jurídico profesional.',
              },
            ].map((item, i) => (
              <details class="group bg-gray-light rounded-sm border border-gray-mid">
                <summary class="flex items-center justify-between p-5 cursor-pointer list-none font-heading font-semibold text-navy text-sm">
                  {item.q}
                  <svg
                    class="w-4 h-4 flex-shrink-0 text-gold transition-transform group-open:rotate-180"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <polyline points="6,9 12,15 18,9"/>
                  </svg>
                </summary>
                <div class="px-5 pb-5 text-gray-text text-sm leading-relaxed border-t border-gray-mid pt-4">
                  {item.a}
                </div>
              </details>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>
</PageLayout>
